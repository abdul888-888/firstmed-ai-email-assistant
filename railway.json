{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "services": {
      "api": {
        "startCommand": "sh -c 'uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}'"
      },
      "worker": {
        "startCommand": "sh -c 'celery -A app.workers.celery_app.celery_app worker --loglevel=info --concurrency=4'"
      },
      "beat": {
        "startCommand": "sh -c 'celery -A app.workers.celery_app.celery_app beat --loglevel=info'"
      }
    }
  }
}