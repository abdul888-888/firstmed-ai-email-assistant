# =============================================================================
# FirstMed AI Email Assistant — environment configuration
# Copy to .env and adjust. NEVER commit the real .env.
# Phase 1 uses only the "core" section; later phases add the rest.
# =============================================================================

# ---- Application ----
APP_NAME="FirstMed AI Email Assistant"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true => JSON logs (use in prod)
API_V1_PREFIX=/api/v1

# ---- Security / Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Encrypts OAuth tokens at rest. Leave blank in dev (derived from SECRET_KEY).
# Prod: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Where the Google OAuth callback redirects the browser after login.
FRONTEND_BASE_URL=http://localhost:3000

# CORS: comma-separated origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=firstmed
POSTGRES_PASSWORD=firstmed
POSTGRES_DB=firstmed
POSTGRES_HOST=localhost            # "db" when running inside docker compose
POSTGRES_PORT=5432
# Optional: overrides the assembled URL if set (async driver)
# DATABASE_URL=postgresql+asyncpg://firstmed:firstmed@localhost:5432/firstmed

# ---- Redis ----
REDIS_HOST=localhost               # "redis" when running inside docker compose
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---- Celery (workers) ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# =============================================================================
# Integrations below are placeholders wired up in later phases (2, 3, 10).
# Leave blank for Phase 1.
# =============================================================================

# ---- Gmail / Google OAuth (Phase 2) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Shared clinical inbox; blank => operate on the signed-in mailbox ("me").
GMAIL_SHARED_INBOX=
# Space- or comma-separated. OIDC identity + read Gmail + create/send drafts.
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose

# ---- Notion (Phase 3) ----
NOTION_API_KEY=                    # internal integration token (secret_...)
NOTION_ROOT_PAGE_ID=               # optional: page/space the integration is shared into
NOTION_VERSION=2022-06-28          # Notion-Version request header

# ---- AI providers (Phase 5+) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=                 # required for triage + draft generation
AI_MODEL=claude-haiku-4-5          # active, cost-friendly Claude model for triage + drafting
AI_MAX_TOKENS=4096
EMBEDDING_MODEL=text-embedding-3-small

# ---- Healzz (Phase 10) ----
HEALZZ_API_BASE_URL=
HEALZZ_API_KEY=

# ---- Observability (Phase 13) ----
SENTRY_DSN=
LANGSMITH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
